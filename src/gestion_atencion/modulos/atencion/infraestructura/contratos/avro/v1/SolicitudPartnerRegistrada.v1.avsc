{
  "type": "record",
  "name": "SolicitudPartnerRegistrada",
  "namespace": "gestion_atencion.eventos",
  "doc": "Integration Event que comunica que una solicitud de partner fue registrada y queda disponible para que otros bounded contexts reaccionen a ese hecho.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "Metadata",
        "doc": "Metadatos del evento para trazabilidad, identificación y versionado del contrato.",
        "fields": [
          {
            "name": "event_id",
            "type": "string",
            "doc": "Identificador único del evento publicado."
          },
          {
            "name": "event_time",
            "type": "long",
            "doc": "Momento del hecho de negocio que origina el evento, expresado en timestamp-millis desde la época Unix."
          },
          {
            "name": "event_type",
            "type": "string",
            "default": "SolicitudPartnerRegistrada",
            "doc": "Nombre del tipo de evento. En este contrato el valor es SolicitudPartnerRegistrada."
          },
          {
            "name": "event_version",
            "type": "string",
            "default": "v1",
            "doc": "Versión del contrato del evento. En este schema V1 corresponde a v1."
          }
        ]
      }
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "SolicitudPartnerRegistradaData",
        "doc": "Payload mínimo del evento de negocio con la información necesaria para crear la atención local.",
        "fields": [
          {
            "name": "solicitud_id",
            "type": "string",
            "doc": "Identificador de la solicitud registrada."
          },
          {
            "name": "partner_id",
            "type": "string",
            "doc": "Identificador del partner asociado a la solicitud."
          },
          {
            "name": "referencia_externa",
            "type": "string",
            "doc": "Referencia externa asociada a la solicitud."
          },
          {
            "name": "tipo_servicio",
            "type": "string",
            "doc": "Tipo de servicio asociado a la solicitud."
          }
        ]
      }
    }
  ]
}
